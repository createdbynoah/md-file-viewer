{
  "name": "md-file-viewer",
  "main": "src/worker.js",
  "compatibility_date": "2025-02-20",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
  },
  // R2 bucket for uploaded markdown files
  "r2_buckets": [
    {
      "binding": "MD_FILES",
      "bucket_name": "md-file-viewer-files",
    },
  ],
  // KV namespace for history + file metadata
  "kv_namespaces": [
    {
      "binding": "HISTORY",
      "id": "4b5e3a41933d4e08b4e048d12d095a96",
    },
  ],
  // Retention cron: archives after 30 days, deletes after 60 days of inactivity
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  // Custom domain routing
  "routes": [
    {
      "pattern": "notebook.noahcancode.com",
      "custom_domain": true,
    },
  ],
  // Default log level for structured logger (override in .dev.vars for local dev)
  "vars": {
    "LOG_LEVEL": "info",
    // Pinned so isDevEnv() can never be true in production (see src/worker.js)
    "ENVIRONMENT": "production",
    // Cloudflare Access application (Zero Trust > Access > Applications).
    // Fill in after creating the app per docs/DEPLOYMENT.md. Not secrets.
    "ACCESS_AUD": "e058d2efd575f343a4a5f6afdcfca400702124cefe076b9e51ed59ea570c4624",
    "ACCESS_TEAM_DOMAIN": "noahcancode.cloudflareaccess.com",
  },
  // Built-in observability (Workers Logs)
  "observability": {
    "enabled": true,
  },
  // UAT env used by scripts/uat.mjs (`wrangler dev --env uat`). Bindings are not
  // inherited by envs, so they are repeated; there is no route or cron here.
  "env": {
    "uat": {
      "r2_buckets": [{ "binding": "MD_FILES", "bucket_name": "md-file-viewer-files" }],
      "kv_namespaces": [{ "binding": "HISTORY", "id": "4b5e3a41933d4e08b4e048d12d095a96" }],
      "vars": {
        "LOG_LEVEL": "debug",
        "ENVIRONMENT": "uat",
        "ACCESS_AUD": "uat-aud",
        "ACCESS_TEAM_DOMAIN": "uat.cloudflareaccess.com",
      },
    },
  },
}
