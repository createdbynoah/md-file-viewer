{
  "name": "md-file-viewer",
  "version": "2.0.0",
  "description": "Lightweight Markdown file viewer on Cloudflare Workers",
  "main": "src/worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat": "node scripts/uat.mjs",
    "uat:stop": "node scripts/uat-stop.mjs",
    "migrate:owner": "node scripts/migrate-owner.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdown-it": "15.0.2",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
